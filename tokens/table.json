  "cmn": "espeak IPA output keeps only the first digit of multi-digit tone phonemes, so 55/51/53 all become '5', 35/33/3 become 'ɜ', 21/214/22/2 become '2'; needs a different phonemizer output",
  "yue": "excluded from the first run; tones 1-7 are lossless in espeak output (3 renders as 'ɜ') and would get yue:tone tokens like vi",
  "th": "excluded from the first run; tones 1-6 are lossless in espeak output (3 renders as 'ɜ') and would get th:tone tokens like vi"
 },
 "rules": [
  {"char": ".", "languages": ["hi", "mr", "ur", "bn", "gu", "ml"], "context": {"prev_chars": ["r"]}, "token": "̢", "meaning": "espeak phoneme r. (retroflex r): hi/mr ड़ ढ़, ur ڑ, bn ড়, gu ડ઼, ml ഴ"},
  {"char": ".", "languages": ["ar"], "context": {"prev_chars": ["a", "i", "u"]}, "token": "ˤ", "meaning": "espeak phonemes a. i. u.: vowel after a 'thick' (emphatic) consonant, backed/pharyngealized"},
  {"char": "?", "languages": ["da"], "context": {"next_chars": ["a", "ɑ"]}, "token": "ʔ", "meaning": "stød: espeak ?&# and ?A spell it '?' in their ipa string, every other Danish stød vowel is written ʔ"},
  {"char": "#", "languages": ["is"], "context": {"prev_chars": ["m", "n", "ɲ", "ŋ", "l", "r"]}, "token": "̊", "meaning": "voiceless sonorant: espeak m# n# ɲ# ŋ# l# tl# r# (hn, hl, hr, nt, rt ...)"},
  {"char": "^", "languages": ["et"], "context": {"prev_chars": ["s", "t", "d"]}, "token": "ʲ", "meaning": "palatalized consonant: espeak s^ t^ d^ (feature pzd)"},
