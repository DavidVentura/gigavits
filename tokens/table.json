  {"char": "\"", "languages": ["ru"], "context": {"prev_chars": ["u"]}, "token": "̈", "meaning": "centralized u: espeak u\" for ю after a consonant (formants vwl_ru/u#u)"},
  {"char": "`", "languages": ["lv"], "context": {"prev_chars": ["a", "o"]}, "token": "̆", "meaning": "shorter variant: espeak a` o`"},
  {"char": "-", "languages": ["lv"], "context": {"prev_chars": ["z"]}, "token": "̆", "meaning": "shorter variant: espeak z-"},
  {"char": "-", "languages": ["fr"], "context": {"prev_chars": ["ə", "a", "e", "ɛ", "y"]}, "token": "̆", "meaning": "unstressed short clitic vowel: espeak @- a- e- E- y- (de, le, la, les, des ...)"},
  {"char": "-", "languages": ["vi"], "context": {"prev_chars": ["e"]}, "token": "̆", "meaning": "short e: espeak e- (anh, ach)"},
  {"char": "-", "languages": ["ko"], "context": {"prev_chars": ["k", "t", "p", "s", "q", "d"]}, "token": "͈", "meaning": "tense consonant: espeak k- t- p- s- q- d-"},
  {"char": "1", "languages": ["fa"], "context": {"prev_chars": ["q"]}, "token": "1", "meaning": "espeak control phoneme phonDEFAULTTONE ('1'), which fa_rules writes after q for ق and غ (q1); no phonetic content, kept for alignment with the fa voices"},
  {"char": "-", "languages": ["ar", "az", "be", "bg", "bn", "bs", "ca", "cs", "da", "de", "el", "en-gb-x-rp", "en-us", "es", "es-419", "et", "eu", "fa", "fi", "fr", "gu", "he", "hi", "hr", "hu", "id", "is", "it", "ja", "ka", "kn", "ko", "lt", "lv", "ml", "mr", "ms", "nb", "nl", "pl", "pt", "pt-br", "ro", "ru", "sk", "sl", "sq", "sr", "sv", "sw", "ta", "te", "tr", "ug", "uk", "ur", "vi"], "context": {"prev_classes": ["consonant"], "skip_classes": ["diacritic"]}, "token": "̩", "meaning": "syllabic consonant: espeak control phoneme '-' (phonSYLLABIC) printed after the consonant"},
  {"char": "1", "languages": ["vi"], "context": {"prev_classes": ["vowel"], "prev_chars": ["ː", "-"]}, "token": "vi:tone1", "meaning": "vi tone phoneme 1, written after the vowel nucleus"},
